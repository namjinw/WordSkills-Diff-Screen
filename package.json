{
  "name": "wordskills-diff-screen",
  "version": "0.2.1",
  "description": "안드로이드 에뮬레이터 화면과 프로토타입 사진을 겹쳐 비교하는 도구",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "build": "electron-builder --win nsis",
    "e2e": "electron . --e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "koffi": "^3.3.8"
  },
  "private": true,
  "devDependencies": {
    "electron-builder": "^26.18.0",
    "electron": "^45.3.1"
  },
  "build": {
    "appId": "kr.wordskills.diffscreen",
    "productName": "WordSkills Diff Screen",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": "nsis"
    },
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "wordskills-diff-screen-setup-${version}.exe"
    }
  }
}
